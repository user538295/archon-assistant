# ══════════════════════════════════════════════════════════════════════
# Archon Configuration Reference
# ══════════════════════════════════════════════════════════════════════
#
# Copy this file to ~/.archon/config.toml and edit as needed.
# Required fields: [access] allowed_user_ids and [session] working_directory.
# All other sections are optional — the defaults shown here are used when
# a section or field is absent from your config.toml.
#
# Sections:
#   [access]             — who can use the bot
#   [session]            — Claude Code workspace settings
#   [output]             — message formatting and length
#   [logging]            — log file location and verbosity
#   [notifications]      — Telegram notification verbosity modes
#   [history]            — conversation history storage and compaction
#   [models]             — available Claude models list
#   [plugins]            — Claude Code plugin integration
#   [search]             — semantic history search (optional)
#   [schedule]            — scheduled tasks (optional)
#   [background_agents]  — parallel Claude agent execution
#   [voice]              — voice note transcription and TTS (optional)
#   [reminder]           — context drift prevention (optional)
# ══════════════════════════════════════════════════════════════════════


# ── Access ────────────────────────────────────────────────────────────
# Controls which Telegram users can interact with the bot.
# This is the only security boundary — configure it before starting the daemon.
# Find your Telegram user ID by messaging @userinfobot on Telegram.

[access]
# List of Telegram user IDs allowed to send messages to the bot.
# All other senders are silently dropped before any handler runs.
# Must contain at least one ID — the daemon refuses to start with an empty list.
# You'd change this if: you want to add another trusted user, or restrict to just yourself.
allowed_user_ids = [123456789]


# ── Session ───────────────────────────────────────────────────────────
# Controls the Claude Code workspace and session lifecycle.
# working_directory is required and must already exist on disk before
# the daemon starts. Both fields must be set explicitly.

[session]
# Absolute or ~-prefixed path to the directory Claude Code will operate in.
# Claude reads and writes files relative to this directory.
# Must exist on disk — the daemon raises a ConfigError if the path is missing.
# You'd change this if: you want Claude to work in a specific project folder.
working_directory = "~/.archon/workspace"

# How long a session stays alive with no user input before it is automatically
# closed, in seconds. Must be > 0. Default is 1800 (30 minutes).
# You'd lower this to free resources on an idle machine; raise it if you often
# return to long-running conversations after extended breaks.
inactivity_timeout_seconds = 1800

# Directory for file attachments received from Telegram.
# Default: {working_directory}/attachments
# attachments_dir = "/path/to/attachments"

# Auto-cleanup files older than this many hours (using file mtime).
# 0 or omit = cleanup disabled.
attachments_cleanup_hours = 12.5


# ── Output ────────────────────────────────────────────────────────────
# Controls how Claude's responses are formatted and chunked before being sent
# to Telegram. Telegram enforces a hard 4096-character limit per message;
# responses exceeding max_message_length are handled by truncation_strategy.

[output]
# Maximum characters per Telegram message. Must be > 0.
# Telegram's hard cap is 4096; leaving headroom avoids edge cases with
# HTML entity encoding overhead.
# You'd lower this if Telegram silently clips messages near the boundary.
max_message_length = 4000

# How to handle responses longer than max_message_length.
# Currently only "split" is implemented:
#   "split"     — split into sequential chunks labeled [1/N], [2/N], ...
#                 All content is delivered; no information is lost.
# A "head_tail" strategy (keep first/last N chars, drop the middle) is planned
# but not yet implemented — setting it will raise a ConfigError at startup.
truncation_strategy = "split"

# Characters to keep from the beginning of a truncated response.
# Reserved for the planned "head_tail" strategy. Ignored for "split".
head_chars = 1500

# Characters to keep from the end of a truncated response.
# Reserved for the planned "head_tail" strategy. Ignored for "split".
tail_chars = 1500


# ── Logging ───────────────────────────────────────────────────────────
# Controls where daemon logs are written and how much detail is recorded.
# Logs rotate daily; a fresh file is also opened on each daemon restart.
# The log directory is created automatically if it does not exist.

[logging]
# Path to the log file. ~ is expanded. Supports absolute paths.
# You'd change this if: you want logs in a shared location, a custom volume,
# or alongside other service logs (e.g. /var/log/archon/archon.log).
log_file = "~/.archon/logs/archon.log"

# How verbose the log output is. Valid values (least to most verbose):
#   "CRITICAL" — only fatal errors that crash the daemon
#   "ERROR"    — errors that prevent an operation from completing
#   "WARNING"  — unexpected but recoverable situations
#   "INFO"     — normal operational events such as session start/stop (recommended)
#   "DEBUG"    — full trace including every SDK message and event mapper decision
# You'd set "DEBUG" when diagnosing a specific problem; revert to "INFO" in
# normal use to keep log files manageable.
log_level = "INFO"


# ── Notifications ─────────────────────────────────────────────────────
# Controls how much detail Archon sends to Telegram while Claude is working.
# The mode can also be changed live via bot commands:
#   /quiet, /normal, /verbose, /debug — take effect immediately, persist to config.

[notifications]
# Verbosity level for orchestrator (main session) events.
# Valid values:
#   "quiet"   — sends only the final response. While Claude is working, a single
#               "still working" beacon message is edited in-place every
#               interval_minutes. Best for clean chats or low-bandwidth connections.
#   "normal"  — sends tool names + a brief result preview + the final response.
#               Balances visibility and noise. Recommended for everyday use.
#   "verbose" — adds thinking blocks, full tool arguments, and full result content
#               on top of everything in "normal". Useful when debugging agent tasks.
#   "debug"   — sends every raw SDK event with full content. Maximum detail; very
#               chatty. Use only when tracing unexpected behaviour.
# You'd change to "quiet" if "normal" generates too many messages during long tasks;
# use "verbose" or "debug" when you need to see exactly what Claude is doing.
mode = "normal"

# Minutes between "still working" beacon edits when mode = "quiet".
# The beacon message is edited in-place rather than sending new messages.
# Set to 0 to disable the beacon entirely (Claude works silently until done).
# You'd lower this (e.g. 1) for more frequent check-ins; raise it or set 0
# if even the occasional edit feels intrusive.
interval_minutes = 2

[notifications.agents]
# Verbosity level for background sub-agent lifecycle events
# (the "Agent X started" / "Agent X done" messages sent during background tasks).
# Omit this subsection entirely — or omit the mode key — to inherit the
# orchestrator mode set above. This is the recommended default.
#
# Valid values: same as [notifications] mode ("quiet", "normal", "verbose", "debug").
# Setting an explicit value here pins agent lifecycle messages to that level
# regardless of what the orchestrator mode is set to.
#
# You'd set an explicit mode here if: you run many background agents and want their
# lifecycle notifications quieter than the main conversation output, for example:
mode = "quiet"


# ── History ───────────────────────────────────────────────────────
# Controls whether conversation turns are written to daily Markdown files and
# whether past sessions are automatically compacted into context digests.
# Change these settings if you want to save disk space, disable logging, or
# tune how much past context Claude sees at the start of each session.

[history]
# Write all conversation turns to daily Markdown files in directory/.
# Each file is available for semantic search via the [search] section below.
# You'd turn this off if you don't want any persistent record of conversations.
enabled = true

# Directory where daily history files are written.
# You'd change this if ~/.archon/history is on a slow or limited-space volume.
directory = "~/.archon/history"

# Tool names whose results are replaced with a compact summary line in history
# files instead of the full output. Accepts any Claude tool name (e.g. "Read",
# "Glob", "Grep", "WebFetch", "Bash"). Reduces file size for high-volume tools.
# You'd add a tool here if its output bloats your history files.
suppressed_tool_results = ["Read", "Glob", "Grep", "WebFetch"]

# Event types to exclude entirely from history files. Reduces noise for high-volume sessions.
# Valid values: thinking, tool_started, tool_result, response, routing_decision, error,
#               classification, routing, fallback, promotion, plan, subagent, wave,
#               recovery, reminder, context_injected
# WARNING: suppressing "response" disables history compaction and context injection.
suppressed_events = ["thinking", "tool_started", "tool_result", "routing_decision", "classification"]

# ── History compaction ────────────────────────────────────────────
# At daemon startup and once per day at midnight, Archon calls Claude Haiku to
# summarise each past day's full history (conversations + agent logs) into a
# ~1000-word digest saved to history/daily/YYYY-MM-DD-compacted.md.
# At the start of every new session the last context_days digests are prepended
# as context so Claude remembers what you worked on recently.
#
# Requires ANTHROPIC_API_KEY to be set in ~/.archon/.env.
# You'd disable this if you don't have an API key or want a clean slate every session.
compaction_enabled = true

# How many past days' digests to inject into each new session.
# 0 = run compaction but do not inject any digests (useful for archiving only).
# You'd raise this to give Claude more historical context; lower it to save tokens.
context_days = 2

# Trigger auto-compaction when the context window reaches this percentage of capacity.
# 0 = disabled; valid range: 20-100.
# Values 1-19 are rejected at startup — they are too aggressive and likely a misconfiguration.
# You'd lower this (e.g. 70) to compact earlier; raise it to delay compaction longer.
auto_compact_threshold = 85


# ── Models ────────────────────────────────────────────────────────
# Defines which Anthropic models appear in the /models inline keyboard and which
# one is active when the daemon starts. Both fields are optional — omit the
# section entirely to use the SDK default and free-text /models entry.

[models]
# Model activated at daemon startup. Must be a valid Anthropic model identifier.
# Comment out (or omit) to use the SDK's own default model.
# You'd set this to your preferred everyday model so you never have to /models on boot.
default = "claude-sonnet-4-6"

[models.available]
# Each entry enables a model and declares its context window size (tokens).
# update_models.py keeps this list current on every release.
# Add custom or proxy models here with their actual context window.
"claude-3-haiku-20240307" = 200_000
"claude-haiku-4-5-20251001" = 200_000
"claude-opus-4-1-20250805" = 200_000
"claude-opus-4-20250514" = 200_000
"claude-opus-4-5-20251101" = 200_000
"claude-opus-4-6" = 1_000_000
"claude-sonnet-4-20250514" = 200_000
"claude-sonnet-4-5-20250929" = 200_000
"claude-sonnet-4-6" = 200_000


[plugins]
# Master switch. Set to false to disable plugin injection entirely.
# You'd turn this off if plugins cause unexpected tool conflicts.
enabled = true

# Directory to scan for plugins. Empty string = use the default (~/.claude/plugins/).
# You'd set an absolute path here if your plugins are outside the default location.
plugins_dir = ""

# Path to the settings.json file that tracks which plugins are enabled.
# Empty string = use the default (~/.claude/settings.json).
# You'd override this if you manage multiple Claude Code profiles.
settings_path = ""


# ── Semantic search ───────────────────────────────────────────────
# Search indexes ~/.archon/history and makes past conversations searchable.
# When enabled, Claude can retrieve relevant past context automatically.

[search]
# Set to true to activate search. Off by default.
# When enabled and the service is installed (via `archon search install`),
# Archon starts the search service automatically on launch (up to 30s wait).
enabled = false

# Hostname where the search server is listening.
host = "localhost"

# Port the search server listens on. Default: 8282.
port = 8282

# Path to the search database directory.
db_path = "~/.archon/search"

# Your personal directories to index as additional search collections.
# Each path is automatically converted to a LanceDB collection name.
# Archon syncs these (plus pinned_collections below) on every service start.
# Add any directory you want to be searchable — notes, docs, projects, etc.
# collections = ["/Users/bob/Documents/", "/Users/bob/Downloads"]
collections = []

# 0 = defer sync to background, HTTP starts immediately (recommended)
sync_timeout_seconds = 0

# Embedding model for vector search (fastembed ONNX — ~33 MB, no GPU required).
embedding_model = "BAAI/bge-small-en-v1.5"

# Reranker model for result scoring.
reranker_model = "BAAI/bge-reranker-v2-m3"

# ONNX execution providers. [] = CPU; ["CUDAExecutionProvider"] = NVIDIA GPU.
# Set automatically by `archon search install` when an NVIDIA GPU is detected.
providers = []

# Number of candidates to retrieve before reranking.
top_k_retrieve = 20

# Number of results to return after reranking (must be < top_k_retrieve).
top_k_return = 5

# Text chunk size in tokens for indexing.
chunk_size = 512

# System collections — always indexed and always searched on every query.
# These are indexed automatically even if not listed in collections above.
# They bypass routing confidence thresholds and are never skipped.
# Pinned collections consume slots in max_parallel_collections, so keep this list short.
# Recommended: leave as-is. Expert users only: set to [] to disable, or add custom paths.
# Example: pinned_collections = ["~/.archon/history/sessions", "~/.archon/workspace", "~/important-docs"]
pinned_collections = [
  "~/.archon/history/sessions",
  "~/.archon/workspace",
]

# Maximum number of search collections to search concurrently per query.
# Pinned collections always consume slots; remaining slots go to routable ones.
# Must be >= 1.  Raise this if you have many collections and want broader coverage.
max_parallel_collections = 3

# Minimum cosine similarity (0.0–1.0) required to include a collection in the
# Tier 3 shortlist after centroid pre-ranking.  Below this threshold the whole
# collection set is dropped (confidence gate failed) and only pinned collections
# are searched.  Lower to be more inclusive; raise to sharpen routing precision.
routing_confidence_threshold = 0.30

# Maximum number of collections forwarded to the decomposer for final selection
# (Tier 2 and Tier 3).  Must be >= 1.  Raise this to give the decomposer more
# options; keep it small to limit routing latency.
routing_shortlist_size = 8

# When true, Archon automatically triggers a full reindex of any collection
# whose stored chunk_size differs from the current config value.  Set to true
# to keep embeddings consistent when you change chunk_size.
auto_reindex_on_chunk_size_change = false

# When true, Archon watches the collection directories for file-system changes
# and automatically re-indexes modified files without a manual `archon search sync` call.
# Requires the `watchdog` optional dependency (`uv sync --extra search`).
watch = false


# ── Job scheduler ────────────────────────────────────────────────
# Runs automated jobs on a schedule. Each job is defined as a standalone TOML
# file in jobs_dir/; the filename stem (without .toml) becomes the job name
# shown in /scheduled. Jobs run a sequential pipeline of shell commands (_tool steps)
# and/or Claude prompts (_prompt steps).
# Change these settings when you want to automate recurring tasks such as health
# checks, daily summaries, or data syncs.

[schedule]
# Master switch. The scheduler is active by default; individual jobs have their
# own enabled flag so you can stage them without disabling the whole scheduler.
enabled = true

# Directory containing per-job TOML files. Relative paths are resolved against
# the directory that contains this config.toml file.
# You'd change this if you store job files outside the project directory.
jobs_dir = "schedules"

# Whether to persist execution history for scheduled tasks.
# When true, each job run is written to a separate Markdown log file under
# ~/.archon/history/schedule/. Defaults to false (disabled).
history_enabled = false

# ── Scheduled job file format ─────────────────────────────────────
# Create one TOML file per job inside jobs_dir/. The filename stem (no .toml)
# becomes the job name. Files are loaded in alphabetical order.
#
# Top-level fields:
#   cron             (required) Standard 5-field cron expression.
#                    Examples: "0 6 * * *" = daily 06:00; "*/15 * * * *" = every 15 min.
#   timeout_seconds  (optional, default 60.0) Per-step timeout in seconds.
#                    The job is aborted and an error is logged if a step exceeds this.
#   enabled          (optional, default true) Set false to skip this job without
#                    deleting the file — useful for staging jobs in development.
#   timezone         (optional) IANA timezone name for the schedule (e.g. "Europe/Budapest",
#                    "America/New_York"). Omit to use the system's local time zone.
#
# [pipeline] section:
#   Each key is a step ID with a mandatory type suffix:
#     _tool   — runs the value as a shell command and captures stdout/stderr.
#     _prompt — sends the value as a prompt to a Claude session and captures the reply.
#   Steps execute in definition order (top to bottom).
#   Use {step_name} in a value to substitute the output of an earlier step.
#   Prefix with $ to suppress substitution: ${literal} is left as-is.
#
# Minimal example (schedules/echo-test.toml):
#
#   cron = "* * * * *"              # every minute
#   timezone = "Europe/Berlin"      # IANA timezone; omit for local time
#   timeout_seconds = 10
#   enabled = false
#
#   [pipeline]
#   test_echo_tool = "echo hello from scheduler"
#
# Two-step example with {ref} substitution (schedules/health-summary.toml):
#
#   cron = "0 6 * * *"              # daily at 06:00
#   timezone = "Europe/Berlin"
#   timeout_seconds = 30
#   enabled = false
#
#   [pipeline]
#   health_check_tool = "scripts/health_check.sh"
#   # {health_check_tool} is replaced with the stdout of the shell command above.
#   summarize_prompt = "Summarize in one line with useful data: {health_check_tool}"


# ── Background Agent Execution ────────────────────────────────────
# Archon hosts a local MCP server that exposes spawn_background_agent to every
# Claude session.  Claude can call this tool to offload subtasks into isolated
# background sessions while the main conversation stays interactive.
# The SDK's native Task tool is always disabled so sub-agents never block the
# main session's response turn.  This MCP server starts automatically on boot.

[background_agents]
# How Claude decides when to spawn background agents.
# Valid values:
#   "eager"  — Claude proactively uses spawn_background_agent for any multi-step
#               or potentially parallel work; maximises concurrency.
#   "auto"   — Claude uses it when doing so would keep the conversation more
#               responsive; balanced default.
#   "manual" — Claude only spawns an agent when the user explicitly asks for it.
# Change this if Claude spawns too many agents unprompted (set "manual") or too
# few for your heavy-workload usage (set "eager").
spawn_rule = "auto"

# Maximum number of background agents allowed to run concurrently per user.
# Change this if you want tighter resource limits or need more parallelism.
max_parallel = 5

# Host the MCP server binds to.  Must be reachable by the Claude process.
# Change this only if you are running Claude and Archon on separate hosts.
host = "localhost"

# TCP port for the background-agent MCP server.
# Must not conflict with other services.  Search uses 8282; this defaults to 18182.
port = 18182

# How often (in minutes) the spawn-notification Telegram message is edited
# in-place with live tool/thinking counts while an agent is running.
# Set to 0 to disable the live beacon entirely.
# Change this if the repeated edits are noisy; 2 minutes is a reasonable cadence.
beacon_interval_minutes = 2

# After this many tool calls within a single direct (non-background) task,
# Archon promotes it to a background agent automatically.
# Set to 0 to disable auto-promotion entirely.
# You'd raise this if short tasks are being promoted prematurely, or lower it
# to move heavy tool-call chains to the background sooner.
tool_promotion_threshold = 10

# TCP port for the router MCP server (used by the routing sub-session and
# background agents). Per-route tool filtering: /mcp (anonymous) sees only
# history tools; /mcp/{user_id} sees history + curated toolkit tools.
# Must not conflict with the background-agent MCP port above.
# Migration note: previously named "orch_mcp_port" — the old key still works
# but will emit a deprecation warning. Update to "router_mcp_port".
# router_mcp_port = 18183


# ── Voice messages (STT + TTS) ────────────────────────────────────
# Enables transcription of incoming Telegram voice notes via Whisper (STT) and
# optional text-to-speech replies back to Telegram (TTS).
# Disabled by default — set enabled = true after satisfying the prerequisites.
#
# Prerequisites:
#   STT : openai-whisper installed  (e.g. pip install openai-whisper or Homebrew)
#   TTS "openai": OPENAI_API_KEY set in ~/.archon/.env
#   TTS "edge"  : edge-tts Python library (free, already a project dependency)

[voice]
# Set to true to enable voice note handling (STT + optional TTS).
# You'd enable this if you want to send Telegram voice notes and receive
# voice replies instead of (or in addition to) text.
enabled = false

[voice.stt]
# Whisper model size to use for transcription.
# Tradeoff: smaller = faster but less accurate; larger = slower but better.
# Valid values (in order of size / quality):
#   "tiny"   — ~39 MB, fastest; usable for clear speech in a quiet environment
#   "base"   — ~74 MB, slightly better accuracy
#   "small"  — ~244 MB, good balance for casual use
#   "medium" — ~769 MB, recommended; solid accuracy across accents (default)
#   "large"  — ~1.5 GB, best accuracy; slow on CPU — only use with a GPU
# Change this if transcription is too slow (go smaller) or inaccurate (go larger).
model = "medium"

# Optional BCP-47 language hint to improve transcription accuracy.
# Omit or comment out to let Whisper auto-detect the language.
# Examples: "en" (English), "hu" (Hungarian), "de" (German), "fr" (French).
# Change this if Whisper frequently mis-detects your language.
# language = "en"

[voice.tts]
# TTS provider to use for voice replies.
# Valid values:
#   "openai" — OpenAI TTS API; high quality; requires OPENAI_API_KEY; costs API credits
#   "edge"   — Microsoft Edge TTS via edge-tts library; free; no API key needed
# Change this to "openai" for noticeably higher quality if you have an API key.
provider = "edge"

# OpenAI TTS model (only used when provider = "openai").
# Valid values:
#   "tts-1"    — faster, slightly lower quality; good for most use cases
#   "tts-1-hd" — higher quality; slower and more expensive
# Change this to "tts-1-hd" if audio quality matters more than latency.
model = "tts-1"

# OpenAI voice name (only used when provider = "openai").
# Valid values: alloy | echo | fable | onyx | nova | shimmer
# Each is a distinct neural voice with different tone and style.
# Change this to match your preferred voice character.
voice = "nova"

# When to generate a TTS voice reply.
# Valid values:
#   "always"  — synthesise every response as a voice note regardless of input type
#   "inbound" — synthesise a voice reply only when the user sent a voice note (default)
#   "off"     — transcribe incoming voice to text but always reply as plain text
# Change this to "always" if you want every response spoken, or "off" to disable TTS
# while keeping STT active.
auto = "inbound"

# Maximum response text length (in characters) to synthesise.
# Responses longer than this are sent as plain text instead of a voice note.
# Change this if you want to cap TTS costs/duration for long answers.
max_text_length = 3000

# Edge TTS voice name (only used when provider = "edge").
# Browse available voices: `edge-tts --list-voices`
# Examples: "en-US-MichelleNeural", "en-GB-SoniaNeural", "de-DE-KatjaNeural"
# Change this to any voice returned by --list-voices that matches your language.
edge_voice = "en-US-MichelleNeural"


# ── Reminder injection ────────────────────────────────────────────
# Periodically injects the contents of workspace/REMINDER.md into the Claude
# session as a user turn to counter context drift in long conversations.
# This helps Claude remember standing instructions, project conventions, and
# key facts that tend to get overlooked as context grows.
# Enabled by default — place your hints in REMINDER.md in the working directory.
# Reminder injection notifications are shown only in verbose/debug mode; suppressed in quiet/normal.

[reminder]
# Set to false to disable periodic context-reminder injection.
# When enabled, Claude re-reads REMINDER.md periodically to prevent context drift.
enabled = true

# Inject a reminder after this many user+assistant messages in the session.
# Must be >= 1.  Combined with interval_tokens as an OR threshold — whichever
# limit is reached first triggers the injection.
# Lower this for frequent reminders in fast-moving conversations.
interval_messages = 12

# Inject a reminder after this many cumulative tokens in the session
# (input_tokens + output_tokens per turn; cache_creation excluded to avoid
# the cold-cache first turn blowing the threshold with system prompt warmup).
# Must be >= 1.  To rely only on the message count, set this to a very large value.
# Lower this if your sessions consume tokens quickly (e.g. long tool outputs).
interval_tokens = 10000
