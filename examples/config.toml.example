[access]
# Telegram user IDs allowed to interact with the bot
allowed_user_ids = [123456789]

[session]
# Working directory Claude Code will operate in
working_directory = "~/.archon/workspace"
# Seconds of inactivity before a session is automatically terminated (must be > 0)
inactivity_timeout_seconds = 1800

[output]
# Maximum Telegram message length; Telegram's hard limit is 4096
max_message_length = 4000
# How to handle messages that exceed max_message_length:
#   "split" — send all chunks labeled [1/N], [2/N], ...
truncation_strategy = "split"
# Used by the "head_tail" strategy (not yet implemented):
# head_chars = 1500
# tail_chars = 1500

[logging]
log_file = "~/.archon/archon.log"
# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
log_level = "INFO"

[notifications]
# Orchestrator notification verbosity (thinking, tool calls, tool results, response):
#   "quiet"   — show only the final response; optionally send a beacon while working
#   "normal"  — show tool names and final response (default)
#   "verbose" — show thinking, tool calls, tool results, and final response
#   "debug"   — show every SDK event (maximum detail)
mode = "normal"
# Minutes between beacon messages in quiet mode (0 = no beacon)
interval_minutes = 2

[notifications.agents]
# Sub-agent lifecycle event verbosity (SubagentStarted / SubagentStopped).
# Omit this section entirely to inherit the orchestrator's mode above.
# With this set to "quiet", agent start/stop events are suppressed (recommended
# default — their results are already visible via the parent's tool result).
#   "quiet"   — hide agent start/stop events (counted in beacon if beacon enabled)
#   "normal"  — show 🤖 Agent: X started / done
#   "verbose" — same as normal (reserved for future per-agent detail)
#   "debug"   — same as normal (reserved for future per-agent detail)
mode = "quiet"

[history]
# Persist conversation turns to daily Markdown files
enabled = true
directory = "~/.archon/history"

[models]
# Pre-configured model list shown as an inline keyboard via /model
# Leave empty (or omit this section) to fall back to free-text model entry only
available = [
    "claude-opus-4-5",
    "claude-sonnet-4-5",
    "claude-haiku-4-5",
]
# Model activated at daemon startup; comment out to use the SDK default
# default = "claude-sonnet-4-5"

[plugins]
# Set to false to disable plugin loading entirely.
enabled = true
# Override the default plugin directory (~/.claude/plugins/).
# Leave empty to use the default.
plugins_dir = ""
# Override the path to ~/.claude/settings.json (for enabled plugin state).
# Leave empty to use the default.
settings_path = ""
