[access]
# Telegram user IDs allowed to interact with the bot
allowed_user_ids = [123456789]

[session]
# Working directory Claude Code will operate in
working_directory = "~/.archon/workspace"
# Seconds of inactivity before a session is automatically terminated
inactivity_timeout_seconds = 1800

[output]
# Telegram's hard limit is 4096; keep some headroom
max_message_length = 4000
# "split"    — send all chunks as [1/N], [2/N], ...
# "head_tail" — keep first head_chars + last tail_chars, omit middle
truncation_strategy = "split"
head_chars = 1500
tail_chars = 1500

[logging]
log_file = "~/.archon/archon.log"
# DEBUG or INFO
log_level = "INFO"

[notifications]
# Show full thinking content (false = only show "💭 Thinking..." indicator)
show_thinking_result = true
# Show brief single-line tool output instead of full content
brief_tool_output = false
# Concise mode:
#   "off"     — show all events (default)
#   "full"    — show only "⏳ Working..." + final response
#   "partial" — show "⏳ Working..." + periodic status updates + final response
concise_mode = "off"
# How often (in minutes) to send a status update in partial mode
concise_interval_minutes = 2

[history]
# Persist conversation turns to daily Markdown files for later semantic search via QMD
enabled = true
directory = "~/.archon/history"
